---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Wei Rong Gao — Software Developer",
  description = "Software developer building simulation, graphics, finance, data, and developer-tooling systems.",
  image = "/og.png"
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://wrgdevs.github.io/Portfolio-site/";
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Wei Rong Gao",
  url: canonical.toString(),
  email: "mailto:wrgao@uwaterloo.ca",
  sameAs: ["https://github.com/wrgdevs"],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Waterloo"
  },
  jobTitle: "Software Developer",
  knowsAbout: [
    "C++",
    "Simulation",
    "Computer Graphics",
    "Game Engines",
    "Python",
    "Financial Software",
    "Data Engineering"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07100d" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content="Wei Rong Gao" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/assets/fonts/sharetechmono.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/assets/images/backgroundw.webp" as="image" type="image/webp" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
