---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScene from "../components/HeroScene";
import ProjectArchive from "../components/ProjectArchive";
import {
  ArrowDown,
  ArrowUpRight,
  Blocks,
  ChartNoAxesCombined,
  CircleDot,
  Code2,
  Cpu,
  Database,
  ExternalLink,
  Mail,
  Menu,
  Orbit,
  PanelsTopLeft,
  Sparkles,
  TerminalSquare
} from "lucide-react";
import { EXPERIENCE, INVOLVEMENT, PROJECTS, PROJECT_FILTERS } from "../../portfolio-data.js";

const repositoryCount = PROJECTS.filter((project) => project.github?.url).length;

const capabilities = [
  {
    title: "Systems & engines",
    description: "Low-level architecture, engine tooling, rendering pipelines, and production debugging where every moving part matters.",
    tags: ["C++20", "ECS", "OpenGL", "SDL2", "Lua"],
    icon: Cpu,
    index: "01"
  },
  {
    title: "Simulation & procedural",
    description: "Data-driven worlds, economies, terrain, agents, and emergent systems built to be inspected as well as experienced.",
    tags: ["Simulation", "Three.js", "WebGL", "Procedural generation"],
    icon: Orbit,
    index: "02"
  },
  {
    title: "Finance & data",
    description: "Decision tools that turn filings, market data, models, and risk assumptions into transparent, useful interfaces.",
    tags: ["Python", "SQL", "Pandas", "FastAPI", "Plotly"],
    icon: ChartNoAxesCombined,
    index: "03"
  },
  {
    title: "Product & tooling",
    description: "Developer-facing editors and user-facing applications shaped around clear workflows, feedback, and maintainable systems.",
    tags: ["React", "TypeScript", "Tooling", "UI architecture"],
    icon: PanelsTopLeft,
    index: "04"
  }
];

const workingOn = [
  {
    label: "C++ / Simulation / Procedural generation",
    title: "Procedural world generation system",
    description: "A living-world simulation connecting terrain, settlements, resources, cultures, factions, and long-term history.",
    details: ["Region-scale generation", "Inspectable simulation state", "Data-driven rules", "Historical event systems"],
    icon: Blocks
  },
  {
    label: "Web app / Finance / Data",
    title: "Stock research platform",
    description: "A research workspace for comparing businesses, tracking investment theses, and building valuation assumptions.",
    details: ["Company comparison", "Financial statements", "Thesis history", "Valuation workflows"],
    icon: Database
  }
];
---

<BaseLayout>
  <div id="top" class="page-shell">
    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a class="brand" href="#top" aria-label="Wei Rong Gao, back to top">
          <span class="brand-mark">WRG</span>
          <span class="brand-copy">
            <strong>Wei Rong Gao</strong>
            <span>Software systems</span>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="#projects">Work</a>
          <a href="#capabilities">Capabilities</a>
          <a href="#experience">Experience</a>
          <a href="#now">Now</a>
          <a href="#about">About</a>
        </nav>

        <div class="header-actions">
          <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label="Toggle reduced motion">
            <CircleDot size={15} aria-hidden="true" />
            <span data-motion-label>Motion on</span>
          </button>
          <a class="header-github" href="https://github.com/wrgdevs" target="_blank" rel="noreferrer" aria-label="GitHub profile">
            <Code2 size={17} aria-hidden="true" />
            <span>GitHub</span>
          </a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
            <Menu size={20} aria-hidden="true" />
            <span class="sr-only">Open navigation</span>
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" data-mobile-menu>
        <a href="#projects">Work <span>01</span></a>
        <a href="#capabilities">Capabilities <span>02</span></a>
        <a href="#experience">Experience <span>03</span></a>
        <a href="#now">Now <span>04</span></a>
        <a href="#about">About <span>05</span></a>
        <a href="#contact">Contact <span>06</span></a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-background" aria-hidden="true"></div>
        <div class="hero-grid">
          <div class="hero-copy" data-reveal>
            <p class="eyebrow"><span></span> Software developer · Mathematics · Co-op</p>
            <h1 id="hero-title">I build systems that make <em>complex ideas</em> tangible.</h1>
            <p class="hero-intro">
              I’m Wei Rong—a developer working across simulation, graphics, game engines, finance, and data. I care about the architecture underneath and the experience on top.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#projects">
                Explore {PROJECTS.length} projects <ArrowDown size={17} aria-hidden="true" />
              </a>
              <a class="button button-secondary" href="mailto:wrgao@uwaterloo.ca">
                Start a conversation <ArrowUpRight size={17} aria-hidden="true" />
              </a>
            </div>
            <div class="hero-availability">
              <span class="availability-pulse" aria-hidden="true"></span>
              <span><strong>Next:</strong> Statistics Canada · Fall 2026</span>
            </div>
          </div>

          <div class="hero-visual" data-reveal>
            <HeroScene client:media="(min-width: 821px)" />
            <div class="hero-visual-topline">
              <span>Interactive systems map</span>
              <span>WRG / 2026</span>
            </div>
            <div class="hero-node-label hero-node-label-a"><span></span> Systems</div>
            <div class="hero-node-label hero-node-label-b"><span></span> Simulation</div>
            <div class="hero-node-label hero-node-label-c"><span></span> Decisions</div>
            <div class="hero-visual-caption">
              <TerminalSquare size={18} aria-hidden="true" />
              <p><strong>Systems in motion.</strong> Built to model, visualize, and interact with complexity.</p>
            </div>
          </div>
        </div>

        <div class="hero-credentials" data-reveal>
          <article>
            <span>Production</span>
            <strong>Digital Extremes</strong>
            <p>Programmer Co-op · C++ game engine</p>
          </article>
          <article>
            <span>Incoming</span>
            <strong>Statistics Canada</strong>
            <p>Cloud developer co-op · Fall 2026</p>
          </article>
          <article>
            <span>Education</span>
            <strong>University of Waterloo</strong>
            <p>Honours Mathematics · Co-operative program</p>
          </article>
          <article class="hero-credential-metric">
            <span>Archive</span>
            <strong>{PROJECTS.length}</strong>
            <p>Projects across systems and products</p>
          </article>
        </div>
      </section>

      <section id="capabilities" class="section capabilities-section" aria-labelledby="capabilities-title">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Capabilities</p>
            <h2 id="capabilities-title">One practice, multiple layers.</h2>
          </div>
          <p>I’m most at home where technical depth and interaction design meet—building the machinery, then making it understandable.</p>
        </div>

        <div class="capability-grid">
          {capabilities.map(({ title, description, tags, icon: Icon, index }) => (
            <article class="capability-card" data-reveal>
              <div class="capability-card-top">
                <span class="capability-icon"><Icon size={22} aria-hidden="true" /></span>
                <span class="capability-index">{index}</span>
              </div>
              <h3>{title}</h3>
              <p>{description}</p>
              <div class="capability-tags">
                {tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="experience" class="section experience-section" aria-labelledby="experience-title">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Experience</p>
            <h2 id="experience-title">Learning in production.</h2>
          </div>
          <p>From proprietary game-engine work to cloud and AI projects, each role has sharpened how I navigate unfamiliar systems.</p>
        </div>

        <div class="experience-layout">
          <div class="experience-summary" data-reveal>
            <div class="experience-summary-sticky">
              <p class="micro-label">Career signal</p>
              <strong>Production code.<br />Independent systems.<br />Collaborative teams.</strong>
              <p>I bring the same mindset to each: understand the constraints, make the system observable, and improve it without losing sight of the people using it.</p>
              <div class="experience-stat-row">
                <span><strong>{EXPERIENCE.length}</strong> chapters</span>
                <span><strong>{repositoryCount}</strong> public repos</span>
              </div>
            </div>
          </div>

          <ol class="experience-timeline">
            {EXPERIENCE.map((item, index) => (
              <li class:list={["experience-item", item.incoming && "is-incoming"]} data-reveal>
                <div class="experience-marker" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                </div>
                <article>
                  <div class="experience-meta">
                    <span>{item.period}</span>
                    {item.status && <span class="status-pill">{item.status}</span>}
                  </div>
                  <h3>{item.role}</h3>
                  <p class="experience-org">{item.organization}</p>
                  <p>{item.summary}</p>
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                  <div class="experience-tech">
                    {item.technologies.map((technology) => <span>{technology}</span>)}
                  </div>
                  {item.note && <p class="experience-note">{item.note}</p>}
                </article>
              </li>
            ))}
          </ol>
        </div>

        <aside class="involvement-band" data-reveal>
          <div>
            <p class="micro-label">Beyond work terms</p>
            <h3>{INVOLVEMENT.title}</h3>
          </div>
          <p>{INVOLVEMENT.summary}</p>
          <ul>
            {INVOLVEMENT.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </aside>
      </section>

      <section id="projects" class="section projects-section" aria-labelledby="projects-title">
        <div class="section-heading projects-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Complete project archive</p>
            <h2 id="projects-title">Built across the stack.</h2>
          </div>
          <p>Every project is available in one place—filter by domain, search by technology, and open any card for the full feature set and gallery.</p>
        </div>

        <ProjectArchive
          projects={PROJECTS}
          filters={PROJECT_FILTERS}
          base={import.meta.env.BASE_URL}
          client:visible
        />
      </section>

      <section id="now" class="section now-section" aria-labelledby="now-title">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> In the lab now</p>
            <h2 id="now-title">Following bigger questions.</h2>
          </div>
          <p>Longer-running builds where the architecture and the domain are still evolving together.</p>
        </div>

        <div class="now-grid">
          {workingOn.map(({ label, title, description, details, icon: Icon }, index) => (
            <article class="now-card" data-reveal>
              <div class="now-card-orbit" aria-hidden="true"></div>
              <div class="now-card-header">
                <span class="now-card-icon"><Icon size={23} aria-hidden="true" /></span>
                <span class="now-card-index">0{index + 1}</span>
              </div>
              <p class="micro-label">{label}</p>
              <h3>{title}</h3>
              <p>{description}</p>
              <ul>
                {details.map((detail) => <li><Sparkles size={14} aria-hidden="true" /> {detail}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="section about-section" aria-labelledby="about-title">
        <div class="about-art" data-reveal>
          <img src="/assets/images/sky.webp" alt="Spaceships navigating a vivid canyon landscape" loading="lazy" decoding="async" />
          <div class="about-art-overlay">
            <span>Curious by default</span>
            <strong>Structure, worlds, and the systems between them.</strong>
          </div>
        </div>

        <div class="about-copy" data-reveal>
          <p class="eyebrow"><span></span> About me</p>
          <h2 id="about-title">The logic underneath matters as much as what appears on screen.</h2>
          <p>I'm a Mathematics student at the University of Waterloo who enjoys building software that models, visualizes, or interacts with complex ideas.</p>
          <p>That can mean an economy evolving over time, an editor making engine data easier to work with, or a valuation tool showing exactly where its numbers came from. The common thread is curiosity about how the pieces connect.</p>
          <div class="about-principles">
            <div><Code2 size={18} aria-hidden="true" /><span><strong>Build deeply</strong>Understand the machinery, not only the API.</span></div>
            <div><PanelsTopLeft size={18} aria-hidden="true" /><span><strong>Make it legible</strong>Good tools reveal what a system is doing.</span></div>
            <div><Sparkles size={18} aria-hidden="true" /><span><strong>Stay curious</strong>Let unfamiliar domains sharpen the engineering.</span></div>
          </div>
        </div>
      </section>

      <section id="contact" class="section contact-section" aria-labelledby="contact-title" data-reveal>
        <div class="contact-copy">
          <p class="eyebrow"><span></span> Contact</p>
          <h2 id="contact-title">Let’s build something thoughtful.</h2>
          <p>If you’re working on an interesting system, technical product, simulation, or tool, I’d be glad to hear about it.</p>
          <div class="contact-actions">
            <a class="button button-light" href="mailto:wrgao@uwaterloo.ca"><Mail size={18} aria-hidden="true" /> wrgao@uwaterloo.ca</a>
            <a class="button button-contact-secondary" href="https://github.com/wrgdevs" target="_blank" rel="noreferrer"><Code2 size={18} aria-hidden="true" /> GitHub <ExternalLink size={14} aria-hidden="true" /></a>
          </div>
        </div>
        <div class="contact-art" aria-hidden="true">
          <img src="/assets/images/robot.webp" alt="" loading="lazy" decoding="async" />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <span class="brand-mark">WRG</span>
        <p>Designed and built around systems in motion.</p>
      </div>
      <p>© {new Date().getFullYear()} Wei Rong Gao</p>
      <a href="#top">Back to top <ArrowUpRight size={14} aria-hidden="true" /></a>
    </footer>
  </div>

  <script>
    import { animate, inView } from "motion";

    const root = document.documentElement;
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const motionToggle = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    const motionLabel = document.querySelector<HTMLElement>("[data-motion-label]");
    const media = window.matchMedia("(prefers-reduced-motion: reduce)");

    const storedPreference = localStorage.getItem("portfolio-motion");
    const reduceEffects = storedPreference === "reduced" || (storedPreference === null && media.matches);
    root.classList.toggle("reduced-effects", reduceEffects);

    const syncMotionButton = () => {
      const reduced = root.classList.contains("reduced-effects");
      motionToggle?.setAttribute("aria-pressed", String(reduced));
      if (motionLabel) motionLabel.textContent = reduced ? "Motion reduced" : "Motion on";
    };
    syncMotionButton();

    motionToggle?.addEventListener("click", () => {
      const reduced = !root.classList.contains("reduced-effects");
      root.classList.toggle("reduced-effects", reduced);
      localStorage.setItem("portfolio-motion", reduced ? "reduced" : "full");
      syncMotionButton();
      window.dispatchEvent(new Event("portfolio:motion"));
    });

    const setMenuOpen = (open: boolean) => {
      menuToggle?.setAttribute("aria-expanded", String(open));
      const menuLabel = menuToggle?.querySelector<HTMLElement>(".sr-only");
      if (menuLabel) menuLabel.textContent = open ? "Close navigation" : "Open navigation";
      mobileMenu?.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
    };

    menuToggle?.addEventListener("click", () => {
      setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
    });
    mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

    const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });

    if (!root.classList.contains("reduced-effects")) {
      root.classList.add("motion-ready");
      inView("[data-reveal]", (element) => {
        element.setAttribute("data-revealed", "true");
        animate(element, { opacity: [0, 1], y: [26, 0] }, { duration: 0.66, ease: [0.22, 1, 0.36, 1] });
      }, { margin: "0px 0px -10% 0px" });
    }

    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".desktop-nav a"));
    const observedSections = navLinks
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((section): section is HTMLElement => Boolean(section));

    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      navLinks.forEach((link) => link.classList.toggle("is-active", link.hash === `#${visible.target.id}`));
    }, { rootMargin: "-30% 0px -60% 0px", threshold: [0, 0.25, 0.5] });

    observedSections.forEach((section) => sectionObserver.observe(section));

    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.getRegistrations().then((registrations) => {
        registrations.forEach((registration) => registration.unregister());
      });
    }

    if ("caches" in window) {
      caches.keys().then((keys) => {
        keys.filter((key) => key.startsWith("portfolio-cache-")).forEach((key) => caches.delete(key));
      });
    }
  </script>
</BaseLayout>
